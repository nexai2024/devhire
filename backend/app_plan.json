      "method": "GET",
      "path": "/api/roles",
      "response": "[{id, title, status, created_at}]",
      "description": "Lists all roles"
    },
    {
      "method": "POST",
      "path": "/api/roles",
      "response": "{id, title, status, created_at}",
      "description": "Creates a new role"
    },
    {
      "method": "GET",
      "path": "/api/candidates",
      "response": "[{id, name, email, role_id, status}]",
      "description": "Lists candidates for a role"
    },
    {
      "method": "POST",
      "path": "/api/challenges",
      "response": "{id, role_id, title, description, difficulty}",
      "description": "Creates a coding challenge"
    },
    {
      "method": "POST",
      "path": "/api/interviews",
      "response": "{id, candidate_id, video_url, submitted_at}",
      "description": "Submits an async video interview"
    },
    {
      "method": "GET",
      "path": "/api/assessments",
      "response": "[{id, candidate_id, score, type}]",
      "description": "Returns skills assessment results"
    },
    {
      "method": "POST",
      "path": "/api/pipeline",
      "response": "{id, role_id, candidate_id, stage, updated_at}",
      "description": "Updates candidate pipeline stage"
    }
  ],
